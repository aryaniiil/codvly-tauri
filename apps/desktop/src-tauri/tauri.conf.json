{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codvly",
  "version": "0.1.0",
  "identifier": "com.codvly.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codvly",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Dark",
        "decorations": false,
        "backgroundColor": "#090a0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
