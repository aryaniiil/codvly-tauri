{
  "name": "codvly",
  "version": "0.1.0",
  "private": true,
  "description": "Code-first developer infrastructure platform. Build, configure and deploy applications from one workspace.",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @codvly/desktop tauri dev",
    "dev:web": "pnpm --filter @codvly/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
